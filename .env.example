# ===== JARVIS personal — configuración =====
# Copia este archivo a .env y rellena lo que necesites.

# --- Cerebro ---
# ollama (local, gratis) | openai (cualquier API compatible) | claude_code (suscripción Claude)
# Interfaz de red: 127.0.0.1 (solo tu Mac) o 0.0.0.0 (servidor).
# Contrasena de acceso. Vacia = sin contrasena (solo uso local).
# OBLIGATORIA si el servidor tiene IP publica.
JARVIS_PASSWORD=
JARVIS_HOST=127.0.0.1
JARVIS_BRAIN_PROVIDER=ollama
# Modelo ligero = responde más rápido. llama3.2 es mucho más ágil que llama3.1.
JARVIS_BRAIN_MODEL=llama3.2
JARVIS_BRAIN_BASE_URL=http://127.0.0.1:11434/v1
# Respuestas cortas = menos tiempo pensando y hablando.
JARVIS_BRAIN_MAX_TOKENS=160
JARVIS_BRAIN_TEMPERATURE=0.4
# Cuantos mensajes de conversacion recuerda (menos = mas rapido y centrado).
JARVIS_HISTORY_MAX_TURNS=10
# Rondas maximas de herramientas por respuesta.
JARVIS_TOOL_ROUNDS=4
# Contexto del modelo (menos = menos memoria; 0 = el del modelo).
JARVIS_BRAIN_NUM_CTX=2048
# --- Protocolo Caida (autodestructivo) ---
# Desactivado por defecto. Ponlo en "si" para permitir el borrado total.
# --- Memoria (persistente en el servidor) ---
# Aprender hechos duraderos automaticamente (una llamada extra al modelo).
JARVIS_MEMORY_AUTO_LEARN=si
# Cuantos hechos recordados se inyectan en cada respuesta.
JARVIS_MEMORY_CONTEXT_LIMIT=20

JARVIS_PROTOCOLO_CAIDA=no
# Frase exacta que hay que decir o escribir para activarlo.
JARVIS_PROTOCOLO_CAIDA_FRASE=PROTOCOLO CAIDA
# Mantiene el modelo cargado en RAM entre preguntas (evita el retraso inicial).
JARVIS_OLLAMA_KEEP_ALIVE=30m
# Si usas openai/groq/gemini/openrouter, pon aquí tu clave:
# JARVIS_BRAIN_API_KEY=sk-...
#   Groq:     base_url=https://api.groq.com/openai/v1     model=llama-3.3-70b-versatile
#   Gemini:   base_url=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-1.5-flash
#   OpenRouter: base_url=https://openrouter.ai/api/v1     model=meta-llama/llama-3.3-70b-instruct:free

# --- Voz ---
# edge (gratis, voz española) | fish (la voz EXACTA del original, de pago) | say (macOS)
JARVIS_VOICE_PROVIDER=edge
# Voz española clara y masculina (estilo JARVIS). Alternativa: es-ES-ElviraNeural
JARVIS_VOICE_NAME=es-ES-AlvaroNeural
# Velocidad: -8% habla algo más despacio y se entiende mejor. Vacío = normal.
JARVIS_VOICE_RATE=-8%
# Tono (opcional). Ej: -5% más grave. Vacío = normal.
JARVIS_VOICE_PITCH=
# Solo para la voz exacta del JARVIS original:
# FISH_API_KEY=tu_key_de_fish_audio
# FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe

# --- Límites de seguridad ---
# Nivel de acceso a comandos:
#   allowlist -> solo comandos seguros de la lista (por defecto, más seguro)
#   confirm   -> cualquier comando, pidiendo permiso antes de cada uno
#   all       -> cualquier comando sin preguntar (¡potente y peligroso!)
JARVIS_SHELL_MODE=allowlist
# Comandos extra que permites sin preguntar (separados por comas).
JARVIS_SHELL_EXTRA_ALLOWED=
# Ejemplos:
#   JARVIS_SHELL_EXTRA_ALLOWED=uptime,df,du,top
#   JARVIS_SHELL_MODE=confirm

# --- Identidad ---
USER_NAME=señor
JARVIS_NAME=JARVIS
JARVIS_LANGUAGE=es
JARVIS_PORT=8765
